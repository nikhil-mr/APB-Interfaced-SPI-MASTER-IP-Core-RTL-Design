module Top_Block(
    pclk, preset_n, paddr, pwrite, penable, psel,
    pwdata, pready, pslverr, ss, sclk, prdata,
    sir, mosi, miso
);

    input pclk, preset_n;
    input [2:0] paddr;
    input pwrite, penable, psel;
    input [7:0] pwdata;
    input miso;

    output pready, pslverr;
    output ss, sclk;
    output [7:0] prdata;
    output sir;
    output mosi;

    wire tip;

    wire mstr;
    wire cpol, cpha;
    wire lsbfe, spiswai;

    wire [2:0] sppr, spr;
    wire [1:0] spi_mode;

    wire send_data;
    wire receive_data;

    wire [7:0] data_miso;
    wire [7:0] data_mosi;

    wire [11:0] baudratedivisor;

    wire mrs1, mrs0;
    wire mss1, mss0;

    // Block 1: APB Slave Interface
    APB_Slave_Interface B1(
        .pclk(pclk),
        .preset_n(preset_n),
        .paddr(paddr),
        .pwrite(pwrite),
        .psel(psel),
        .penable(penable),
        .pwdata(pwdata),

        .ss(ss),
        .tip(tip),
        .data_miso(data_miso),
        .receive_data(receive_data),

        .prdata(prdata),
        .mstr(mstr),
        .cpol(cpol),
        .cpha(cpha),
        .lsbfe(lsbfe),
        .spiswai(spiswai),
        .sppr(sppr),
        .spr(spr),
        .sir(sir),
        .send_data(send_data),
        .data_mosi(data_mosi),
        .spi_mode(spi_mode),
        .pready(pready),
        .pslverr(pslverr)
    );

    // Block 2: Baud Rate Generator
    Baud_Rate_Generator B2(
        .pclk(pclk),
        .preset_n(preset_n),
        .spi_mode(spi_mode),
        .spiswai(spiswai),
        .sppr(sppr),
        .spr(spr),
        .cpol(cpol),
        .cpha(cpha),
        .ss(ss),
        .sclk(sclk),
        .mrs1(mrs1),
        .mrs0(mrs0),
        .mss1(mss1),
        .mss0(mss0),
        .baudratedivisor(baudratedivisor)
    );

    // Block 3: Shift Register
    Shift_register B3(
        .pclk(pclk),
        .preset_n(preset_n),
        .ss(ss),
        .send_data(send_data),
        .lsbfe(lsbfe),
        .cpha(cpha),
        .cpol(cpol),
        .mrs1(mrs1),
        .mrs0(mrs0),
        .mss1(mss1),
        .mss0(mss0),
        .data_mosi(data_mosi),
        .miso(miso),
        .receive_data(receive_data),
        .mosi(mosi),
        .data_miso(data_miso)
    );

    // Block 4: SPI Slave Select Control
    SPI_Slave_Select_Block B4(
        .pclk(pclk),
        .preset_n(preset_n),
        .mstr(mstr),
        .spiswai(spiswai),
        .spi_mode(spi_mode),
        .send_data(send_data),
        .baudratedivisor(baudratedivisor),
        .receive_data(receive_data),
        .ss(ss),
        .tip(tip)
    );

endmodule
